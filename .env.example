.env.example
# Application
NODE_ENV=development
APP_PORT=3000

# HCM Integration
HCM_BASE_URL=http://localhost:4000
HCM_DEGRADATION_MODE=OPTIMISTIC
HCM_CIRCUIT_BREAKER_THRESHOLD=5
HCM_CIRCUIT_BREAKER_WINDOW_MS=60000
HCM_TIMEOUT_MS=5000

# Database
DATABASE_PATH=./data/leave-mgmt.db

# Logging
LOG_LEVEL=debug
